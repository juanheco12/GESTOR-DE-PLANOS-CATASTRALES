# Base de datos PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_db?sslmode=require"

# NextAuth — genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secreto-aqui"

# URL pública de tu app en Vercel (sin barra al final)
NEXTAUTH_URL="https://tu-proyecto.vercel.app"
