generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EJECUTOR)
  password      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requests          Request[]
  historyLogs       History[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  plansRegistered   Plan[]              @relation("PlanoRegistradoPor")
  pushSubs          PushSubscription[]
  prestamosEntregados Prestamo[]        @relation("PrestamoEntregadoPor")
  prestamosRecibidos  Prestamo[]        @relation("PrestamoDevueltoPor")
}

enum Role {
  ADMINISTRADOR
  ENCARGADO
  EJECUTOR
  RADICADORA
}

model Plan {
  id                     String      @id @default(cuid())
  radicado               String      @unique
  mutacion               String
  fechaIngreso           DateTime    @default(now())
  formato                String
  propietario            String?
  predial                String?
  veredaBarrio           String?
  profesionalResponsable String?
  observaciones          String?
  ubicacionFisica        String?
  estado                 PlanState   @default(DISPONIBLE)
  inconsistencias        String?
  qrCode                 String?
  receivedById           String?
  receivedBy             Receiver?   @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  registradoPorId        String?
  registradoPor          User?       @relation("PlanoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  requests               Request[]
  history                History[]
  notifications          Notification[]
  prestamos              Prestamo[]
}

model Receiver {
  id          String   @id @default(cuid())
  name        String   @unique
  createdAt   DateTime @default(now())

  plans       Plan[]
}

enum PlanState {
  DISPONIBLE
  PRESTADO
  ARCHIVADO
  PENDIENTE_REVISION
}

model Request {
  id              String       @id @default(cuid())
  planId          String
  userId          String       // Quién solicita
  adminEntregaId  String?      // Admin que autorizó y entregó
  estado          RequestState @default(PENDIENTE)
  observaciones    String?
  fechaSolicitud  DateTime   @default(now())
  fechaEntrega    DateTime?
  fechaDevolucion DateTime?
  ultimoRecordatorio DateTime? // Último "volver a llamar" enviado por el ejecutor

  plan         Plan         @relation(fields: [planId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
}

enum RequestState {
  PENDIENTE
  LISTO_PARA_ENTREGA
  ENTREGADO
  DEVOLUCION_SOLICITADA
  DEVUELTO
  RECHAZADO
}

model History {
  id          String   @id @default(cuid())
  planId      String
  userId      String   // Quién realizó la acción
  accion      String   // ej. REGISTRO, SOLICITUD, ENTREGA, DEVOLUCION, EDICION
  detalles    String?  // Detalles de la acción o cambios de estado
  createdAt   DateTime @default(now())

  plan        Plan     @relation(fields: [planId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityId    String
  entityType  String
  oldData     String?
  newData     String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  userId    String
  planoId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan?    @relation(fields: [planoId], references: [id], onDelete: SetNull)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Prestamo {
  id              String    @id @default(cuid())
  planId          String
  entregadoPorId  String
  nombreReceptor  String
  entidad         String    @default("Secretaría de Planeación")
  cargo           String
  motivo          String
  telefono        String?
  observaciones   String?
  fechaEntrega    DateTime  @default(now())
  fechaDevolucion DateTime?
  devueltoPorId   String?

  plan         Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  entregadoPor User  @relation("PrestamoEntregadoPor", fields: [entregadoPorId], references: [id])
  devueltoPor  User? @relation("PrestamoDevueltoPor",  fields: [devueltoPorId],  references: [id])

  @@index([planId])
}
