generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EJECUTOR)
  password      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requests          Request[]
  historyLogs       History[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  plansRegistered   Plan[]              @relation("PlanoRegistradoPor")
  pushSubs          PushSubscription[]
  prestamosEntregados Prestamo[]        @relation("PrestamoEntregadoPor")
  prestamosRecibidos  Prestamo[]        @relation("PrestamoDevueltoPor")
  verificaciones      Verificacion[]
  llamadosSolicitados LlamadoVerificacion[] @relation("LlamadoSolicitante")
  llamadosAtendidos   LlamadoVerificacion[] @relation("LlamadoDigitalizador")
}

enum Role {
  ADMINISTRADOR
  ENCARGADO
  EJECUTOR
  RADICADORA
  DIGITALIZADOR
}

model Plan {
  id                     String      @id @default(cuid())
  radicado               String      @unique
  mutacion               String
  fechaIngreso           DateTime    @default(now())
  formato                String
  propietario            String?
  predial                String?
  veredaBarrio           String?
  profesionalResponsable String?
  observaciones          String?
  ubicacionFisica        String?
  estado                 PlanState   @default(DISPONIBLE)
  inconsistencias        String?
  qrCode                 String?
  receivedById           String?
  receivedBy             Receiver?   @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  registradoPorId        String?
  registradoPor          User?       @relation("PlanoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  requests               Request[]
  history                History[]
  notifications          Notification[]
  prestamos              Prestamo[]
  llamados               LlamadoVerificacion[]
}

model Receiver {
  id          String   @id @default(cuid())
  name        String   @unique
  createdAt   DateTime @default(now())

  plans       Plan[]
}

enum PlanState {
  DISPONIBLE
  PRESTADO
  ARCHIVADO
  PENDIENTE_REVISION
}

model Request {
  id              String       @id @default(cuid())
  planId          String
  userId          String       // Quién solicita
  adminEntregaId  String?      // Admin que autorizó y entregó
  estado          RequestState @default(PENDIENTE)
  observaciones    String?
  fechaSolicitud  DateTime   @default(now())
  fechaEntrega    DateTime?
  fechaDevolucion DateTime?
  ultimoRecordatorio DateTime? // Último "volver a llamar" enviado por el ejecutor

  plan         Plan         @relation(fields: [planId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
}

enum RequestState {
  PENDIENTE
  LISTO_PARA_ENTREGA
  ENTREGADO
  DEVOLUCION_SOLICITADA
  DEVUELTO
  RECHAZADO
  CANCELADO
}

model History {
  id          String   @id @default(cuid())
  planId      String
  userId      String   // Quién realizó la acción
  accion      String   // ej. REGISTRO, SOLICITUD, ENTREGA, DEVOLUCION, EDICION
  detalles    String?  // Detalles de la acción o cambios de estado
  createdAt   DateTime @default(now())

  plan        Plan     @relation(fields: [planId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityId    String
  entityType  String
  oldData     String?
  newData     String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  userId    String
  planoId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan?    @relation(fields: [planoId], references: [id], onDelete: SetNull)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verificacion {
  id            String   @id @default(cuid())
  // Opcionales: el plano puede llegar a revisión sin radicar todavía.
  // El radicado lo asigna ventanilla después, al radicarlo.
  fmi           String?
  radicado      String?
  cumple        Boolean
  // Concepto técnico: PROCEDE | NO_PROCEDE | REQUIERE_AJUSTE.
  // `cumple` se conserva como resumen booleano para el histórico.
  resultado     String?
  observaciones String?
  imagenNombre  String?
  imagenData    String?
  userId        String
  createdAt     DateTime @default(now())

  // Verificación anterior del mismo folio que esta revisión subsana
  subsanaId     String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  llamado       LlamadoVerificacion?
  subsana       Verificacion?  @relation("Subsanacion", fields: [subsanaId], references: [id], onDelete: SetNull)
  subsanadaPor  Verificacion[] @relation("Subsanacion")
  adjuntos      VerificacionAdjunto[]

  @@index([fmi])
}

// Archivos de respaldo de una verificación. Tabla aparte porque son varios
// y porque su contenido es pesado: así la lista no los arrastra.
model VerificacionAdjunto {
  id             String   @id @default(cuid())
  verificacionId String
  nombre         String
  data           String
  createdAt      DateTime @default(now())

  verificacion   Verificacion @relation(fields: [verificacionId], references: [id], onDelete: Cascade)

  @@index([verificacionId])
}

// Solicitud de ventanilla (radicador / encargado) para que el digitalizador
// revise un plano. Deja registro de quién llamó, cuándo, y cuándo se atendió.
model LlamadoVerificacion {
  id              String       @id @default(cuid())
  radicado        String?
  fmi             String?
  nota            String?
  formato         String?
  // Check-in de ventanilla cuando el digitalizador no está: queda registrado
  // de inmediato como derecho de petición, sin esperar verificación.
  esDerechoPeticion Boolean    @default(false)
  estado          LlamadoState @default(PENDIENTE)
  solicitanteId   String
  digitalizadorId String?
  verificacionId  String?      @unique
  // Plano creado en el sistema al registrar el derecho de petición
  planId          String?
  createdAt       DateTime     @default(now())
  tomadoEn        DateTime?
  finalizadoEn    DateTime?

  solicitante   User          @relation("LlamadoSolicitante",   fields: [solicitanteId],   references: [id], onDelete: Cascade)
  digitalizador User?         @relation("LlamadoDigitalizador", fields: [digitalizadorId], references: [id], onDelete: SetNull)
  verificacion  Verificacion? @relation(fields: [verificacionId], references: [id], onDelete: SetNull)
  plan          Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([solicitanteId])
}

enum LlamadoState {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model Prestamo {
  id              String    @id @default(cuid())
  planId          String
  entregadoPorId  String
  nombreReceptor  String
  entidad         String    @default("Secretaría de Planeación")
  cargo           String
  motivo          String
  telefono        String?
  observaciones   String?
  fechaEntrega    DateTime  @default(now())
  fechaDevolucion DateTime?
  devueltoPorId   String?

  plan         Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  entregadoPor User  @relation("PrestamoEntregadoPor", fields: [entregadoPorId], references: [id])
  devueltoPor  User? @relation("PrestamoDevueltoPor",  fields: [devueltoPorId],  references: [id])

  @@index([planId])
}
